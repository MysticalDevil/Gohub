APP_ENV=testing
APP_KEY=unit-test-key
APP_DEBUG=false
APP_URL=http://127.0.0.1:3000
APP_PORT=3000
TIMEZONE=UTC

DB_CONNECTION=sqlite
DB_SQL_FILE=/tmp/gohub_api_smoke.db
DB_MAX_IDLE_CONNECTIONS=1
DB_MAX_OPEN_CONNECTIONS=1
DB_MAX_LIFE_SECONDS=5

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAIN_DB=1
REDIS_CACHE_DB=0

JWT_EXPIRE_TIME=120
JWT_MAX_REFRESH_TIME=86400

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=gohub@example.com
MAIL_FROM_NAME=Gohub

VERIFY_CODE_LENGTH=6
VERIFY_CODE_EXPIRE=15

LOG_TYPE=daily
LOG_LEVEL=error
